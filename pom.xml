<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<!-- `mvn verify`'s PMD report goal prints "[WARNING] Unable to find a URL to the parent
		 project. The parent menu will NOT be added." on every run. Verified experimentally that
		 adding a <url> to this POM does NOT clear it - it refers to spring-boot-starter-parent's
		 own (external, Spring-owned) POM lacking a resolvable site URL. Not fixable from here;
		 harmless, since this project doesn't publish a Maven site. -->
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.1</version>
		<relativePath/>
	</parent>
	<groupId>br.com.ronybrand</groupId>
	<artifactId>spring-order-api</artifactId>
	<version>1.0.0-SNAPSHOT</version>
	<name>spring-order-api</name>
	<description>Order API do Rony Reinehr Brand - gestao de pedidos (Customer/Order/Item)</description>
	<properties>
		<java.version>25</java.version>
		<!-- O pin antigo em 2.21.1 existia porque 2.21.4 nao resolvia (metadata indisponivel em
			 repo.maven.apache.org) - confirmado que isso ja nao acontece mais. Bumped de 2.21.1 para
			 2.22.1 porque springdoc-openapi 3.1.1 traz swagger-core-jakarta 2.2.55, que ja exige
			 jackson-datatype-jsr310/jackson-dataformat-yaml/jackson-databind nessa versao -
			 requireUpperBoundDeps falha sem isso (mesmo tipo de divergencia que motivou o pin original). -->
		<!-- Dependabot alerts #14/#17/#18/#20: jackson-databind/jackson-core 2.22.0-2.22.2 have
			 several high-severity issues (quadratic forward-reference completion, unbounded raw-type-ID
			 retention, unbounded XMLGregorianCalendar number parse, missing maxErrorTokenLength limit) -
			 fixed in 2.22.3. -->
		<jackson-2-bom.version>2.22.3</jackson-2-bom.version>
		<!-- Spring Boot 4.1.1 pulls Jackson 3 (tools.jackson.core) transitively via
			 spring-boot-starter-jackson, pinned at 3.1.5 by spring-boot-dependencies - same CVE family as
			 jackson-2-bom.version above (Dependabot alerts #15/#16/#19/#21), fixed in 3.1.7. Overrides the
			 inherited spring-boot-dependencies property the same way jackson-2-bom.version does. -->
		<jackson-bom.version>3.1.7</jackson-bom.version>
		<!-- Dependabot alerts #3/#4/#5 (critical): Tomcat's embedded FORM/DIGEST authenticators and
			 access-control checks in 11.0.0-M1..11.0.24 have authentication-bypass issues, fixed in
			 11.0.25. Overrides spring-boot-dependencies' own tomcat.version property. -->
		<tomcat.version>11.0.26</tomcat.version>
		<!-- Pending Dependabot bump of the amqp-client dependencyManagement pin (see PR #29) needs
			 5.36.0, whose own POM requires netty-codec/netty-handler 4.2.18.Final - above the
			 4.2.17.Final spring-boot-dependencies manages via this same property. Bumped ahead of
			 that PR landing, same rationale as jackson-2-bom.version above: harmless now (nothing on
			 the current 5.31.0 amqp-client pin needs it), just removes requireUpperBoundDeps's failure
			 once the amqp-client pin actually moves. -->
		<netty.version>4.2.18.Final</netty.version>
		<!-- Single source of truth for the byte-buddy-agent javaagent path, referenced by both
			 Surefire and Failsafe below - keeps the two argLine declarations from drifting apart. -->
		<byteBuddyAgent.path>${project.build.directory}/byte-buddy-agent.jar</byteBuddyAgent.path>
	</properties>
	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-liquibase</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
		</dependency>
		<!-- /actuator/health (with Postgres/Mongo/Redis/RabbitMQ indicators auto-registered) and
			 /actuator/metrics/prometheus - see commons/config/ActuatorSecurityConfig for exposure
			 rules and application.yml for what's enabled. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>
		<dependency>
			<groupId>io.micrometer</groupId>
			<artifactId>micrometer-registry-prometheus</artifactId>
		</dependency>
		<!-- Async notification when an order's status changes (confirm/cancel) -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-amqp</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-mail</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-thymeleaf</artifactId>
		</dependency>
		<!-- Brings in spring-context-support (CaffeineCacheManager), used by CacheConfig for
			 @Cacheable reads (e.g. Customer.findById). -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-cache</artifactId>
		</dependency>
		<!-- Swagger/OpenAPI - enabled only in the dev profile (see commons/config and application.yml) -->
		<dependency>
			<groupId>org.springdoc</groupId>
			<artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
			<version>3.1.1</version>
		</dependency>
		<!-- PostgreSQL in every environment (dev via docker-compose, IT via Testcontainers, production via env vars) -->
		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
			<scope>runtime</scope>
		</dependency>
		<!-- MongoDB read-model (CQRS) for Order, populated asynchronously from the projection queue -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-mongodb</artifactId>
		</dependency>
		<!-- Idempotency key for the notification consumer (SET NX + TTL), preventing a duplicate
			 email on RabbitMQ redelivery of an already-processed message. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-redis</artifactId>
		</dependency>
		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<scope>provided</scope>
		</dependency>
		<dependency>
			<groupId>org.apache.commons</groupId>
			<artifactId>commons-lang3</artifactId>
		</dependency>
		<dependency>
			<groupId>org.apache.commons</groupId>
			<artifactId>commons-collections4</artifactId>
			<version>4.6.0</version>
		</dependency>
		<!-- Backs the rate limiter's window map with a bounded, self-expiring structure instead of a
			 plain ConcurrentHashMap, so it doesn't grow unbounded with distinct IPs/users over the
			 application's lifetime. Not used for @Cacheable/read caching (out of scope for now). -->
		<dependency>
			<groupId>com.github.ben-manes.caffeine</groupId>
			<artifactId>caffeine</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
		<!-- Byte Buddy agent for Mockito's inline mock maker on Java 21+ -->
		<dependency>
			<groupId>net.bytebuddy</groupId>
			<artifactId>byte-buddy-agent</artifactId>
			<scope>test</scope>
		</dependency>
		<!-- WebMvcTest/MockMvc on Spring Boot 4 (not included in spring-boot-starter-test) -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc-test</artifactId>
			<scope>test</scope>
		</dependency>
		<!-- TestRestTemplate on Spring Boot 4 -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-resttestclient</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-restclient</artifactId>
			<scope>test</scope>
		</dependency>
		<!-- Testcontainers: the *ControllerIT tests bring up a real PostgreSQL in a container -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-testcontainers</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>testcontainers-junit-jupiter</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>testcontainers-postgresql</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>testcontainers-mongodb</artifactId>
			<scope>test</scope>
		</dependency>
		<!-- No dedicated org.testcontainers Redis module exists (the official one is a third-party
			 com.redis:testcontainers-redis artifact) - a plain GenericContainer against the redis
			 image, via the core org.testcontainers:testcontainers artifact already brought in
			 transitively by testcontainers-junit-jupiter above, is simpler and stays within the
			 same BOM-managed group as the rest of this project's Testcontainers modules. -->
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>testcontainers</artifactId>
			<scope>test</scope>
		</dependency>
		<!-- Real RabbitMQ for *IT - exercises the actual exchange/queue/DLQ bindings declared in
			 RabbitMQConfig/OrderProjectionConfig, which a mocked RabbitTemplate/MessageListener
			 (the rest of this project's messaging tests) can never catch a mistake in. -->
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>testcontainers-rabbitmq</artifactId>
			<!-- Not managed by spring-boot-starter-parent (unlike testcontainers-postgresql/mongodb) -
				 pinned to match the version resolved for those elsewhere in this build. -->
			<version>2.0.5</version>
			<scope>test</scope>
		</dependency>
		<!-- Consumer-driven contract testing (message pact) for the order-status-changed
			 notification message, produced by OutboxService/OutboxPublisher (see ADR 0006) and
			 consumed by OrderNotificationRabbitListener. -->
		<dependency>
			<groupId>au.com.dius.pact.consumer</groupId>
			<artifactId>junit5</artifactId>
			<version>4.7.5</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>au.com.dius.pact.provider</groupId>
			<artifactId>junit5</artifactId>
			<version>4.7.5</version>
			<scope>test</scope>
		</dependency>
	</dependencies>
	<dependencyManagement>
		<dependencies>
			<!-- spring-boot-dependencies:4.1.1 manages amqp-client at 5.30.0, mas spring-rabbit
				 (tambem gerenciado pelo mesmo BOM) ja depende de 5.31.0 - gap do proprio BOM upstream.
				 Pin explicito so pra alinhar com o que spring-rabbit ja pede, sem ir alem do que o
				 Spring Boot testou. -->
			<dependency>
				<groupId>com.rabbitmq</groupId>
				<artifactId>amqp-client</artifactId>
				<version>5.37.0</version>
			</dependency>
			<!-- BouncyCastle (bcprov/bcpkix-jdk18on) comes transitively from pact-jvm's junit5 modules
				 above, test-scoped only - not managed by any property in spring-boot-dependencies, unlike
				 jackson-2-bom.version/jackson-bom.version/tomcat.version above. Dependabot alerts
				 #1/#2/#6/#7: bcprov/bcpkix-jdk18on below 1.84/1.85 have an LDAP injection, a Name
				 Constraints bypass via trailing dot in rfc822Name/URI, a lazy ASN.1 sequence nesting-depth
				 guard bypass, and a broken/risky crypto algorithm - fixed in 1.84/1.85. Pinned together
				 with bcutil-jdk18on (not itself alerted, but released in lockstep with the other two -
				 keeping it on the same train avoids a silent 1.81.1-vs-1.86 split). -->
			<dependency>
				<groupId>org.bouncycastle</groupId>
				<artifactId>bcprov-jdk18on</artifactId>
				<version>1.86</version>
			</dependency>
			<dependency>
				<groupId>org.bouncycastle</groupId>
				<artifactId>bcpkix-jdk18on</artifactId>
				<version>1.86</version>
			</dependency>
			<dependency>
				<groupId>org.bouncycastle</groupId>
				<artifactId>bcutil-jdk18on</artifactId>
				<version>1.86</version>
			</dependency>
		</dependencies>
	</dependencyManagement>
	<build>
		<plugins>
			<!-- Pega downgrade silencioso de dependencia transitiva vs. o que o dependencyManagement
				 (proprio ou herdado do spring-boot-dependencies) declara - ver os pins de
				 jackson-2-bom.version e amqp-client acima, ambos fechados por essa regra antes dela
				 ser adicionada aqui. dependencyConvergence (a regra classica) NAO foi usada: da falso
				 positivo pra dependencia gerenciada via BOM (commons-collections4/commons-text), que
				 requireUpperBoundDeps entende corretamente. -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-enforcer-plugin</artifactId>
				<version>3.6.3</version>
				<executions>
					<execution>
						<id>enforce-upper-bound-deps</id>
						<goals>
							<goal>enforce</goal>
						</goals>
						<configuration>
							<rules>
								<requireUpperBoundDeps/>
							</rules>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
				<configuration>
					<excludes>
						<exclude>
							<groupId>org.projectlombok</groupId>
							<artifactId>lombok</artifactId>
						</exclude>
					</excludes>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<configuration>
					<release>25</release>
					<annotationProcessorPaths>
						<path>
							<groupId>org.projectlombok</groupId>
							<artifactId>lombok</artifactId>
						</path>
						<path>
							<groupId>org.springframework.boot</groupId>
							<artifactId>spring-boot-configuration-processor</artifactId>
							<version>4.1.1</version>
						</path>
					</annotationProcessorPaths>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-dependency-plugin</artifactId>
				<executions>
					<execution>
						<id>copy-byte-buddy-agent</id>
						<phase>process-test-resources</phase>
						<goals>
							<goal>copy</goal>
						</goals>
						<configuration>
							<artifactItems>
								<artifactItem>
									<groupId>net.bytebuddy</groupId>
									<artifactId>byte-buddy-agent</artifactId>
									<destFileName>byte-buddy-agent.jar</destFileName>
									<outputDirectory>${project.build.directory}</outputDirectory>
								</artifactItem>
							</artifactItems>
							<!-- destFileName above must match the filename in byteBuddyAgent.path. -->
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<configuration>
					<!-- Providers run in Failsafe after consumers generate the Pact files. -->
					<excludes>
						<exclude>**/*PactProviderTest.java</exclude>
					</excludes>
					<argLine>@{argLine} -Xmx768m -javaagent:${byteBuddyAgent.path} -Djava.net.preferIPv4Stack=true</argLine>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-failsafe-plugin</artifactId>
				<configuration>
					<!-- Providers must run after Surefire consumers have generated target/pacts. -->
					<includes>
						<include>**/*IT.java</include>
						<include>**/*PactProviderTest.java</include>
					</includes>
					<argLine>@{argLine} -Xmx1536m -javaagent:${byteBuddyAgent.path} -Djava.net.preferIPv4Stack=true</argLine>
				</configuration>
				<executions>
					<execution>
						<goals>
							<goal>integration-test</goal>
							<goal>verify</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.graalvm.buildtools</groupId>
				<artifactId>native-maven-plugin</artifactId>
			</plugin>
			<plugin>
				<groupId>org.jacoco</groupId>
				<artifactId>jacoco-maven-plugin</artifactId>
				<version>0.8.15</version>
				<executions>
					<execution>
						<id>jacoco-prepare-agent</id>
						<goals>
							<goal>prepare-agent</goal>
						</goals>
					</execution>
					<execution>
						<id>jacoco-report</id>
						<phase>verify</phase>
						<goals>
							<goal>report</goal>
						</goals>
						<configuration>
							<excludes>
								<exclude>**/SpringOrderApiApplication.class</exclude>
								<exclude>**/commons/config/**</exclude>
							</excludes>
						</configuration>
					</execution>
					<execution>
						<id>jacoco-check</id>
						<goals>
							<goal>check</goal>
						</goals>
						<configuration>
							<excludes>
								<exclude>**/SpringOrderApiApplication.class</exclude>
								<exclude>**/commons/config/**</exclude>
							</excludes>
							<rules>
								<rule>
									<element>BUNDLE</element>
									<limits>
										<limit>
											<counter>LINE</counter>
											<value>COVEREDRATIO</value>
											<minimum>0.80</minimum>
										</limit>
										<limit>
											<counter>BRANCH</counter>
											<value>COVEREDRATIO</value>
											<minimum>0.65</minimum>
										</limit>
									</limits>
								</rule>
							</rules>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-pmd-plugin</artifactId>
				<version>3.28.0</version>
				<configuration>
					<rulesets>
						<ruleset>config/pmd/pmd-ruleset.xml</ruleset>
					</rulesets>
					<printFailingErrors>true</printFailingErrors>
					<failOnViolation>true</failOnViolation>
					<linkXRef>false</linkXRef>
				</configuration>
				<executions>
					<execution>
						<id>pmd-check</id>
						<phase>verify</phase>
						<goals>
							<goal>pmd</goal>
							<goal>check</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>
</project>
